{
  "name": "@crxig-rxberts/code-standards",
  "version": "0.2.4",
  "description": "Shared lint/format/commit-hook standards (oxlint, oxfmt, prek, terraform fmt/tflint, markdownlint, conventional commits) for crxig-rxberts projects",
  "keywords": [
    "code-standards",
    "conventional-commits",
    "markdownlint",
    "oxfmt",
    "oxlint",
    "pre-commit",
    "prek",
    "terraform",
    "tflint"
  ],
  "license": "MIT",
  "author": "",
  "bin": {
    "code-standards-js-format": "packages/commit-hooks/bin/js-format.mjs",
    "code-standards-js-lint": "packages/commit-hooks/bin/js-lint.mjs",
    "code-standards-markdown-lint": "packages/commit-hooks/bin/markdown-lint.mjs",
    "code-standards-terraform-fmt": "packages/commit-hooks/bin/terraform-fmt.mjs",
    "code-standards-terraform-tflint": "packages/commit-hooks/bin/terraform-tflint.mjs"
  },
  "files": [
    "packages/commit-hooks/index.mjs",
    "packages/commit-hooks/bin/"
  ],
  "type": "module",
  "exports": "./packages/commit-hooks/index.mjs",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint:pre-commit": "oxlint --config oxlint.config.mjs",
    "format:pre-commit": "oxfmt -c oxfmt.config.mjs",
    "test": "node --test packages/commit-hooks/test/",
    "release": "release-it",
    "release:workspace": "release-it --config packages/commit-hooks/.release-it.workspace.mjs"
  },
  "dependencies": {
    "markdownlint-cli2": "0.23.2"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "release-it": "21.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
